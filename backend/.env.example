# GesturGait AI - Backend Environment Variables Template
# Copy this to .env for local development
# Use these keys in your Render.com / Cloud environment settings

# The port the server will run on (Render provides this automatically)
PORT=5000

# Your MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/gesturgait
MONGODB_URI=

# A long, random string for securing login tokens
# Generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# The URL where your ML Engine (FastAPI) is hosted
# Use http://localhost:8000 for local dev
# Use your Render ML URL for production
ML_ENGINE_URL=http://localhost:8000
